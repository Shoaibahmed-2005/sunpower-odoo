# Copy to server/.env and fill in. Never commit server/.env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sunpower
JWT_SECRET=change-me-to-a-long-random-string

# Razorpay test-mode keys (dashboard.razorpay.com -> Test mode -> API Keys). Leave empty to disable online payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# true = show the OTP on screen and in the server log (demo). false = only deliver() sends it (plug in an SMS provider).
OTP_DEMO=true
